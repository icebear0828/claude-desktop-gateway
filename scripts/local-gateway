#!/usr/bin/env sh
set -eu

usage() {
  echo "usage: scripts/local-gateway <start|stop|restart|status> [--dry-run]" >&2
}

if [ "$#" -lt 1 ]; then
  usage
  exit 2
fi

command=$1
shift
dry_run=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
  shift
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
env_file=${CLAUDE_GATEWAY_ENV_FILE:-"$repo_root/.env.local"}
config_file=${CLAUDE_GATEWAY_CONFIG:-"$repo_root/gateway.local.json"}
state_dir=${CLAUDE_GATEWAY_STATE_DIR:-"$repo_root/.local-gateway"}
pid_file="$state_dir/gateway.pid"
log_file="$state_dir/gateway.log"
binary_file="$state_dir/gateway"
health_url=${CLAUDE_GATEWAY_HEALTH_URL:-"http://127.0.0.1:8787/health"}

require_env() {
  name=$1
  eval "value=\${$name:-}"
  if [ -z "$value" ]; then
    echo "$name is required" >&2
    exit 1
  fi
}

load_local_config() {
  if [ ! -f "$env_file" ]; then
    echo "missing env file: $env_file" >&2
    echo "copy .env.local.example to .env.local and set OPENROUTER_API_KEY and CLAUDE_GATEWAY_API_KEY" >&2
    exit 1
  fi

  set -a
  . "$env_file"
  set +a

  if [ ! -f "$config_file" ]; then
    echo "missing config file: $config_file" >&2
    echo "copy gateway.local.example.json to gateway.local.json" >&2
    exit 1
  fi

  require_env OPENROUTER_API_KEY
  require_env CLAUDE_GATEWAY_API_KEY
  export CLAUDE_GATEWAY_CONFIG="$config_file"
}

managed_pid() {
  if [ ! -f "$pid_file" ]; then
    return 1
  fi
  pid=$(sed -n '1p' "$pid_file" | tr -d '[:space:]')
  case "$pid" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  if kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid"
    return 0
  fi
  rm -f "$pid_file"
  return 1
}

health_ok() {
  command -v curl >/dev/null 2>&1 && curl -fsS "$health_url" >/dev/null 2>&1
}

status_command() {
  if pid=$(managed_pid); then
    echo "local gateway running: pid $pid"
    echo "log: $log_file"
    return 0
  fi
  if health_ok; then
    echo "local gateway reachable at $health_url but not managed by this script"
    return 0
  fi
  echo "local gateway stopped"
  return 1
}

start_command() {
  load_local_config
  if pid=$(managed_pid); then
    echo "local gateway already running: pid $pid"
    echo "log: $log_file"
    return 0
  fi
  if health_ok; then
    echo "local gateway already reachable at $health_url"
    echo "no managed pid file: $pid_file"
    return 0
  fi
  if [ "$dry_run" -eq 1 ]; then
    echo "local gateway start dry run OK"
    echo "state dir: $state_dir"
    echo "log: $log_file"
    return 0
  fi

  mkdir -p "$state_dir"
  (
    cd "$repo_root"
    go build -o "$binary_file" ./cmd/gateway
  )

  (
    cd "$repo_root"
    nohup "$binary_file" > "$log_file" 2>&1 &
    echo "$!" > "$pid_file"
  )

  tries=0
  while [ "$tries" -lt 10 ]; do
    if health_ok; then
      pid=$(sed -n '1p' "$pid_file" | tr -d '[:space:]')
      echo "local gateway started: pid $pid"
      echo "health: $health_url"
      echo "log: $log_file"
      return 0
    fi
    tries=$((tries + 1))
    sleep 1
  done

  echo "local gateway did not become healthy; see $log_file" >&2
  return 1
}

stop_command() {
  if pid=$(managed_pid); then
    if [ "$dry_run" -eq 1 ]; then
      echo "local gateway stop dry run OK: pid $pid"
      return 0
    fi
    kill -TERM "$pid"
    tries=0
    while [ "$tries" -lt 10 ]; do
      if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pid_file"
        echo "local gateway stopped: pid $pid"
        return 0
      fi
      tries=$((tries + 1))
      sleep 1
    done
    echo "local gateway still running after TERM: pid $pid" >&2
    return 1
  fi
  if health_ok; then
    echo "local gateway is reachable but not managed by this script" >&2
    return 1
  fi
  echo "local gateway is not managed by this script"
  return 1
}

case "$command" in
  start)
    start_command
    ;;
  stop)
    stop_command
    ;;
  restart)
    stop_command || true
    start_command
    ;;
  status)
    status_command
    ;;
  *)
    usage
    exit 2
    ;;
esac
